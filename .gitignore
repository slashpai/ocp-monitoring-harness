# Local task work — working documents, not committed (Jira/PR are the system of record)
/tasks/*
!/tasks/README.md
/completed/*
!/completed/.gitkeep

# Secrets and local cluster access — never commit
.env
.env.*
!.env.example
*.pem
*kubeconfig*

# OS files
.DS_Store
Thumbs.db

# Cursor — only .cursor/rules/ and the .cursor/skills symlink are committed
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills

# Claude Code — only the .claude/skills symlink is committed
.claude/*
!.claude/skills

/tmp/

# Local tool binaries (installed via make install-mdox, etc.)
/bin/

# Editor files
*.swp
*.swo
*~
